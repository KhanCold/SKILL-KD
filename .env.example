DASHSCOPE_API_KEY=

# Override these if using a non-DashScope provider
SKILL_KD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Meta-variable: tells SKILL-KD which env var holds the API key.
# Change this if your key lives under a different name (e.g. OPENAI_API_KEY).
SKILL_KD_API_KEY_ENV=DASHSCOPE_API_KEY

SKILL_KD_MAX_ITERS=3

# --- Local vLLM mode (optional) ---
# Set per-role base URLs to mix local and remote endpoints.
# When pointing to localhost, DashScope-specific extensions are auto-skipped.
#
# STUDENT_BASE_URL=http://localhost:8000/v1
# TEACHER_BASE_URL=http://localhost:8001/v1
